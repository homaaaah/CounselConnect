# CounselConnect backend environment template.
# Copy to `.env` and fill real values locally. NEVER commit real credentials.

# --- Database (MySQL 8.4 LTS, PyMySQL sync driver) ---
# Individual-connection form (COUNSELCONNECT_ prefix per naming conventions):
COUNSELCONNECT_DB_HOST=localhost
COUNSELCONNECT_DB_PORT=3306
COUNSELCONNECT_DB_NAME=counselconnect
COUNSELCONNECT_DB_USER=
COUNSELCONNECT_DB_PASSWORD=

# --- Application ---
# Allowed CORS origins for the Vite dev server / Capacitor web view.
COUNSELCONNECT_CORS_ORIGINS=["http://localhost:5173"]

# --- Scheduled appointment chat ---
# Keep one backend process while the WebSocket registry is in memory.
COUNSELCONNECT_CHAT_GRACE_MINUTES=15
COUNSELCONNECT_CHAT_RETENTION_DAYS=30
COUNSELCONNECT_CHAT_MAX_MESSAGE_CHARACTERS=4000
COUNSELCONNECT_CHAT_MAINTENANCE_INTERVAL_SECONDS=30

# --- Appointment video calls (ADR-034) ---
# JSON ICE list. Public STUN is the default; add TURN for strict NATs. Static
# TURN credentials are a v1 compromise and are only returned to an authorized
# participant inside the appointment call window.
COUNSELCONNECT_CALL_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
COUNSELCONNECT_CALL_SIGNAL_MAX_BYTES=65536
COUNSELCONNECT_CALL_SIGNAL_MESSAGES_PER_MINUTE=300

# --- Non-MySQL storage roots (private, outside the repo working tree) ---
# Temporary private COR store: maximum seven-day pending lifetime.
COUNSELCONNECT_COR_STORAGE_ROOT=./var/cor
# Controlled durable store for Counselor-authored internal resource files.
COUNSELCONNECT_RESOURCE_STORAGE_ROOT=./var/resources

# --- Automated COR screening (ADR-029) ---
# Requires Poppler (pdftotext/pdftoppm) and Tesseract OCR plus the
# zxing-cpp and Pillow Python packages. Leave unset to use PATH; set
# explicitly when the tools are installed off-PATH. Use forward slashes
# (dotenv treats `\b` and similar as escape sequences).
# COUNSELCONNECT_PDFTOTEXT_PATH=C:/poppler/Library/bin/pdftotext.exe
# COUNSELCONNECT_PDFTOPPM_PATH=C:/poppler/Library/bin/pdftoppm.exe
# COUNSELCONNECT_TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
# COUNSELCONNECT_COR_SCREENING_ENABLED=true
